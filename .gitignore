# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# intermediate output from the one-off logo tracing scripts
/scripts/out

.vercel

# analytics database and backups
/data

# Windows caddy.exe downloaded by start-site.bat
/tools/caddy.exe
/tools/caddy.exe.download
/tools/Caddyfile

# local debug / server logs
.cursor/
dev.log
dev.err.log
*.log
